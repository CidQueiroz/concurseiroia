# ==============================================================================
# APROVATECK - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copie este arquivo para .env e preencha com suas credenciais reais.
# NUNCA commite o arquivo .env no controle de versão!

# Supabase (Autenticação e Banco de Dados Principal)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-anon-public-key-ou-service-role-key

# Provedores de IA (Opcionais - Fallbacks globais caso o usuário não informe BYOK)
GROQ_API_KEY=gsk_sua_chave_groq_aqui
GEMINI_API_KEY1=sua_chave_gemini_aqui
OPENROUTER_API_KEY1=sua_chave_openrouter_aqui
